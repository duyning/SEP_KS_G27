# Copy to .env.local and use the Wi-Fi IPv4 address of the computer running Spring Boot.
# Do not use localhost on a physical phone. Backend HL-RCS uses port 8081.
EXPO_PUBLIC_API_URL=http://192.168.10.148:8081

# Must match app.google.client-id on Spring Boot (public OAuth client ID, not a secret).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1094293729879-chv3qjptfp4sh6gjg547g07mavqm9v9e.apps.googleusercontent.com
# iOS OAuth client, required only for iOS development/production builds.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Set the registered native application identifiers before building.
HLRCS_IOS_BUNDLE_ID=
HLRCS_ANDROID_PACKAGE=

