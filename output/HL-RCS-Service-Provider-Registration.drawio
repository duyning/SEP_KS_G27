<mxCell id="33" value="1. Enter service details, select images,&lt;br&gt;and submit the form" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="220" as="sourcePoint"/><mxPoint x="295" y="220" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="34" value="2. Validate form fields and required images" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="265" as="sourcePoint"/><mxPoint x="305" y="290" as="targetPoint"/><Array as="points"><mxPoint x="350" y="265"/><mxPoint x="350" y="290"/></Array></mxGeometry></mxCell>
<mxCell id="35" value="3. POST /api/service-registrations" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="325" as="sourcePoint"/><mxPoint x="595" y="325" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="36" value="4. submit(details, documents, image)" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="605" y="375" as="sourcePoint"/><mxPoint x="885" y="375" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="37" value="5. Validate and normalize registration data;&lt;br&gt;require at least one image" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="425" as="sourcePoint"/><mxPoint x="895" y="450" as="targetPoint"/><Array as="points"><mxPoint x="940" y="425"/><mxPoint x="940" y="450"/></Array></mxGeometry></mxCell>
<mxCell id="38" value="6. Check the service category" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="490" as="sourcePoint"/><mxPoint x="1155" y="490" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="39" value="7. Resolve the authenticated applicant" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="550" as="sourcePoint"/><mxPoint x="895" y="575" as="targetPoint"/><Array as="points"><mxPoint x="940" y="550"/><mxPoint x="940" y="575"/></Array></mxGeometry></mxCell>
<mxCell id="40" value="8. Lock the applicant account" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="610" as="sourcePoint"/><mxPoint x="1365" y="610" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="41" value="9. Check registration eligibility" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="670" as="sourcePoint"/><mxPoint x="895" y="695" as="targetPoint"/><Array as="points"><mxPoint x="940" y="670"/><mxPoint x="940" y="695"/></Array></mxGeometry></mxCell>
<mxCell id="42" value="10. Check for a duplicate service name&lt;br&gt;among non-deleted services" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="730" as="sourcePoint"/><mxPoint x="1565" y="730" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="43" value="11. Check for a duplicate service name&lt;br&gt;among PENDING / NEEDS_SUPPLEMENT applications" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="795" as="sourcePoint"/><mxPoint x="1805" y="795" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="44" value="12. Save the registration as PENDING" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="855" as="sourcePoint"/><mxPoint x="1805" y="855" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="45" value="13. Validate and attach service images;&lt;br&gt;maximum 5 images, 5 MB each, JPG/PNG/WEBP" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="915" as="sourcePoint"/><mxPoint x="895" y="940" as="targetPoint"/><Array as="points"><mxPoint x="940" y="915"/><mxPoint x="940" y="940"/></Array></mxGeometry></mxCell>
<mxCell id="46" value="14. Build the registration result — info(row)" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="985" as="sourcePoint"/><mxPoint x="895" y="1010" as="targetPoint"/><Array as="points"><mxPoint x="940" y="985"/><mxPoint x="940" y="1010"/></Array></mxGeometry></mxCell>
<mxCell id="47" value="15. Find the service linked to the registration" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="1050" as="sourcePoint"/><mxPoint x="1565" y="1050" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="48" value="16. Read registration document metadata" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="1110" as="sourcePoint"/><mxPoint x="2075" y="1110" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="49" value="17. Check the applicant's current capability" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="1165" as="sourcePoint"/><mxPoint x="895" y="1190" as="targetPoint"/><Array as="points"><mxPoint x="940" y="1165"/><mxPoint x="940" y="1190"/></Array></mxGeometry></mxCell>
<mxCell id="50" value="18. RegistrationInfo (committed)&lt;br&gt;or business error (rolled back)" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=open;endFill=0;dashed=1;dashPattern=5 3;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="885" y="1230" as="sourcePoint"/><mxPoint x="605" y="1230" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="51" value="19. HTTP 201 + ApiResponse&amp;lt;RegistrationInfo&amp;gt; (PENDING)&lt;br&gt;or business error (400 / 409)" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=open;endFill=0;dashed=1;dashPattern=5 3;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="1295" as="sourcePoint"/><mxPoint x="305" y="1295" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="52" value="20. Display submission success and PENDING status,&lt;br&gt;or display validation/business errors" style="html=1;rounded=0;strokeColor=#34495E;strokeWidth=1.3;endArrow=block;endFill=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=bottom;spacingBottom=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="1350" as="sourcePoint"/><mxPoint x="70" y="1350" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>