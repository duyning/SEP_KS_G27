<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="hlrcs-screen-flow" name="Web Screen Flow"><mxGraphModel dx="3540" dy="2370" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3540" pageHeight="2370" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t0" value="HL-RCS — SCREEN FLOW" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=38;fontColor=#26363d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="22" width="3540" height="42" as="geometry"/></mxCell><mxCell id="t1" value="WEB • source snapshot 26 Nov 2026 • Screens only — no popups or drawers" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#26363d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="79" width="3540" height="42" as="geometry"/></mxCell><mxCell id="t2" value="AUTHENTICATION" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fontColor=#26363d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1380" y="130" width="780" height="42" as="geometry"/></mxCell><mxCell id="t3" value="After login: authorized return URL first; otherwise USER → Home / ROOM_HOST → Host / STAFF → Staff / ADMIN → Admin." style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#26363d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="430" y="274" width="2680" height="42" as="geometry"/></mxCell><mxCell id="t4" value="PUBLIC" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=25;fontColor=#26363d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="350" width="1110" height="42" as="geometry"/></mxCell><mxCell id="t5" value="Guests can open public pages directly. Navigation arrows include shared menus." style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#26363d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="390" width="1110" height="42" as="geometry"/></mxCell><mxCell id="t6" value="SIGNED-IN ACCOUNTS" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=25;fontColor=#26363d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1040" width="1110" height="42" as="geometry"/></mxCell><mxCell id="t7" value="Shared navigation / account links. Feature-specific access rules still apply." style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#26363d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="1080" width="1110" height="42" as="geometry"/></mxCell><mxCell id="t8" value="Saved Rooms + Comparison: USER / ROOM_HOST only." style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#26363d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="430" y="1207" width="700" height="42" as="geometry"/></mxCell><mxCell id="t9" value="Host application: USER; existing host sees status." style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#26363d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="430" y="1655" width="700" height="42" as="geometry"/></mxCell><mxCell id="t10" value="Entry: tenant invitation link → login if needed → signing screen." style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#26363d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="1835" width="1110" height="42" as="geometry"/></mxCell><mxCell id="t11" value="Profile tabs and Community “My posts” stay inside their parent screen." style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#26363d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="1900" width="1110" height="42" as="geometry"/></mxCell><mxCell id="t12" value="Service registration, My Services, service requests/reports, contact," style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#26363d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="1970" width="1110" height="42" as="geometry"/></mxCell><mxCell id="t13" value="booking details and contract editor are popups: intentionally excluded." style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#26363d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="1997" width="1110" height="42" as="geometry"/></mxCell><mxCell id="t14" value="STAFF" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=25;fontColor=#26363d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="350" width="1110" height="42" as="geometry"/></mxCell><mxCell id="t15" value="STAFF / ADMIN • entry points include the shared Staff sidebar" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#26363d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1220" y="390" width="1110" height="42" as="geometry"/></mxCell><mxCell id="t16" value="ADMIN" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=25;fontColor=#26363d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="1450" width="1110" height="42" as="geometry"/></mxCell><mxCell id="t17" value="Assignment Monitoring: view current assignees; no assign/reassign form." style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#26363d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1220" y="1970" width="1110" height="42" as="geometry"/></mxCell><mxCell id="t18" value="* Support/Assistance screens exist but use mock data in current frontend." style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#26363d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1220" y="2010" width="1110" height="42" as="geometry"/></mxCell><mxCell id="t19" value="ROOM HOST" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=25;fontColor=#26363d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2420" y="350" width="1090" height="42" as="geometry"/></mxCell><mxCell id="t20" value="ROOM_HOST / ADMIN • Host routes remain subject to ownership checks." style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#26363d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2420" y="390" width="1090" height="42" as="geometry"/></mxCell><mxCell id="t21" value="Properties / Room Types / Rooms share one workspace shell." style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#26363d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2420" y="2020" width="1090" height="42" as="geometry"/></mxCell><mxCell id="t22" value="USER" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#26363d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="420" y="280" width="100" height="42" as="geometry"/></mxCell><mxCell id="t23" value="STAFF" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#26363d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1220" y="340" width="100" height="42" as="geometry"/></mxCell><mxCell id="t24" value="ADMIN" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#26363d;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1200" y="1465" width="160" height="42" as="geometry"/></mxCell><mxCell id="t25" value="READING THE DIAGRAM" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=24;fontColo