API_TARGET=http://127.0.0.1:8081

# Leaflet / OpenStreetMap (no Google API key required)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Extra provider attribution; OpenStreetMap credit always remains visible.
VITE_MAP_TILE_ATTRIBUTION=

# Alternative for LOCAL development if tile.openstreetmap.org is unreachable:
# VITE_MAP_TILE_URL=https://tile.openstreetmap.de/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.de/">OpenStreetMap Deutschland</a>
# Check provider terms before commercial deployment.

# Optional satellite imagery: configure an authorized provider (no Google key required).
# URLs are XYZ templates; ArcGIS providers may use {z}/{y}/{x}.
VITE_MAP_SATELLITE_URL=
VITE_MAP_SATELLITE_ATTRIBUTION=
# Optional transparent road/place labels for satellite view.
VITE_MAP_LABELS_URL=
VITE_MAP_LABELS_ATTRIBUTION=
# street or satellite; satellite needs URL and attribution above.
VITE_MAP_DEFAULT_VIEW=street

# Google browser key: restrict HTTP referrers and Maps JavaScript API.
# auto uses Google when a key exists; osm always uses OpenStreetMap.
VITE_MAP_PROVIDER=auto
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Google OAuth Web client ID (same value as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=1094293729879-chv3qjptfp4sh6gjg547g07mavqm9v9e.apps.googleusercontent.com
