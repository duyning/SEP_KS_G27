    class User {
        <<Entity>>
        -Integer userId
        -String fullName
        -String email
        -String phoneNumber
        -String passwordHash
        -UserRole role
        -UserStatus status
        -LocalDateTime createdAt
    }
    class ModerationLog {
        <<Entity>>
        -Integer logId
