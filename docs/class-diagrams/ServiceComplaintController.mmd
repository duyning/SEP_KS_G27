        <<Service>>
        +hasCapability()
        +isPublic()
    }
    class ServiceComplaint {
        <<Entity>>
        -Integer complaintId
        -Service service
        -User reporter
        -String content
        -String status
        -Instant createdAt
        -int revision
        -List~ServiceImage~ images
    }
    class ServiceComplaintEvent {
        <<Entity>>
        -Integer eventId
        -ServiceComplaint complaint
