        -String action
        -String content
        -Instant createdAt
        -List~ServiceImage~ images
    }
    class Service {
        <<Entity>>
        -Integer serviceId
        -User provider
        -ServiceCategory category
        -ServiceRegistration registration
        -String serviceName
        -String contactInfo
        -String contactEmail
        -String pricingType
