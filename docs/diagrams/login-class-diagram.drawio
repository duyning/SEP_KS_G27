        <mxCell id="UserRole" value="&lt;table cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;background:#eeeeee;border-bottom:1px solid #888888;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:36px;text-align:right;vertical-align:middle;padding:5px 6px 5px 10px;&quot;&gt;&lt;div style=&quot;width:20px;height:20px;line-height:20px;border-radius:50%;background:#fde68a;border:1px solid #b45309;color:#78350f;font-weight:bold;font-size:12px;text-align:center;&quot;&gt;E&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;text-align:left;vertical-align:middle;padding:5px 10px 5px 4px;line-height:1.2;&quot;&gt;&lt;i style=&quot;font-size:11px;color:#333333;&quot;&gt;«Enum»&lt;/i&gt;&lt;br/&gt;&lt;b style=&quot;font-size:13px;color:#111111;&quot;&gt;UserRole&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;padding:6px 10px;text-align:left;font-size:11px;line-height:1.35;color:#111111;&quot;&gt;USER&lt;br/&gt;ROOM_HOST&lt;br/&gt;STAFF&lt;br/&gt;ADMIN&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#888888;overflow=hidden;" vertex="1" parent="1">
