        <mxCell id="UserCapability" value="&lt;table cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;background:#eeeeee;border-bottom:1px solid #888888;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:48px;text-align:right;vertical-align:middle;padding:5px 6px 5px 10px;&quot;&gt;&lt;div style=&quot;width:20px;height:20px;line-height:20px;border-radius:50%;background:#b7e1cd;border:1px solid #4a7c59;color:#1b4332;font-weight:bold;font-size:12px;text-align:center;&quot;&gt;C&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;text-align:left;vertical-align:middle;padding:5px 10px 5px 4px;line-height:1.2;&quot;&gt;&lt;i style=&quot;font-size:11px;color:#333333;&quot;&gt;«Entity»&lt;/i&gt;&lt;br/&gt;&lt;b style=&quot;font-size:13px;color:#111111;&quot;&gt;UserCapability&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;padding:6px 10px;text-align:left;font-size:11px;line-height:1.35;color:#111111;&quot;&gt;-userCapabilityId: Integer&lt;br/&gt;-status: String&lt;br/&gt;-grantedAt: LocalDateTime&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#888888;overflow=hidden;" vertex="1" parent="1">
