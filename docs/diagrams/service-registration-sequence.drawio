eometry"><mxPoint x="304" y="345" as="sourcePoint"/><mxPoint x="536" y="345" as="targetPoint"/></mxGeometry></mxCell><mxCell id="38" value="3. submit(details, documents, images)" style="html=1;fontFamily=Arial;fontSize=15;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="544" y="405" as="sourcePoint"/><mxPoint x="796" y="405" as="targetPoint"/></mxGeometry></mxCell><mxCell id="39" value="4. Validate fields, required images&lt;br&gt;and normalize service areas" style="html=1;fontFamily=Arial;fontSize=15;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="804" y="465" as="sourcePoint"/><mxPoint x="804" y="493" as="targetPoint"/><Array as="points"><mxPoint x="849" y="465"/><mxPoint x="849" y="493"/></Array></mxGeometry></mxCell><mxCell id="40" value="5. findById(categoryId)" style="html=1;fontFamily=Arial;fontSize=15;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="804" y="545" as="sourcePoint"/><mxPoint x="1056" y="545" as="targetPoint"/></mxGeometry></mxCell><mxCell id="41" value="6. Category" style="html=1;fontFamily=Arial;fontSize=15;endArrow=open;endFill=0;dashed=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1056" y="575" as="sourcePoint"/><mxPoint x="804" y="575" as="targetPoint"/></mxGeometry></mxCell><mxCell id="42" value="7. Lock applicant: findForRegistrationUpdate(currentUserId)" style="html=1;fontFamily=Arial;fontSize=15;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="804" y="625" as="sourcePoint"/><mxPoint x="1296" y="625" as="targetPoint"/></mxGeometry></mxCell><mxCell id="43" value="8. Applicant" style="html=1;fontFamily=Arial;fontSize=15;endArrow=open;endFill=0;dashed=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1296" y="655" as="sourcePoint"/><mxPoint x="804" y="655" as="targetPoint"/></mxGeometry></mxCell><mxCell id="44" value="9. restriction(userId): check capability / onboarding state" style="html=1;fontFamily=Arial;fontSize=15;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="804" y="715" as="sourcePoint"/><mxPoint x="804" y="743" as="targetPoint"/><Array as="points"><mxPoint x="849" y="715"/><mxPoint x="849" y="743"/></Array></mxGeometry></mxCell><mxCell id="45" value="Helper calls condensed: AuthService resolves the authenticated applicant.&lt;br&gt;restriction() uses ServicePublicationService and ServiceRegistrationRepository.&lt;br&gt;ACTIVE MANAGE_SERVICE permits additional registrations;&lt;br&gt;otherwise check existing approved / pending applications." style="html=1;fontFamily=Arial;fontSize=15;shape=note;size=15;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1050" y="690" width="1050" height="100" as="geometry"/></mxCell><mxCell id="46" value="10. Check duplicate name among non-DELETED services" style="html=1;fontFamily=Arial;fontSize=15;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="804" y="845" as="sourcePoint"/><mxPoint x="1536" y="845" as="targetPoint"/></mxGeometry></mxCell><mxCell id="47" value="11. No duplicate listing" style="html=1;fontFamily=Arial;fontSize=15;endArrow=open;endFill=0;dashed=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1536" y="875" as="sourcePoint"/><mxPoint x="804" y="875" as="targetPoint"/></mxGeometry></mxCell><mxCell id="48" value="12. Check duplicate name in PENDING / NEEDS_SUPPLEMENT applications" style="html=1;fontFamily=Arial;fontSize=15;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="804" y="925" as="sourcePoint"/><mxPoint x="1776" y="925" as="targetPoint"/></mxGeometry></mxCell><mxCell id="49" value="13. No duplicate pending application" style="html=1;fontFamily=Arial;fontSize=15;endArrow=open;endFill=0;dashed=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1776" y="955" as="sourcePoint"/><mxPoint x="804" y="955" as="targetPoint"/></mxGeometry></mxCell><mxCell id="50" value="14. save(new ServiceRegistration, status = PENDING)" style="html=1;fontFamily=Arial;fontSize=15;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="804" y="1005" as="sourcePoint"/><mxPoint x="1776" y="1005" as="targetPoint"/></mxGeometry></mxCell><mxCell id="51" value="15. Saved registration" style="html=1;fontFamily=Arial;fontSize=15;endArrow=open;endFill=0;dashed=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1776" y="1035" as="sourcePoint"/><mxPoint x="804" y="1035" as="targetPoint"/></mxGeometry></mxCell><mxCell id="52" value="16. [For each optional document] Validate and save(ServiceDocument)" style="html=1;fontFamily=Arial;fontSize=15;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="804" y="1085" as="sourcePoint"/><mxPoint x="2016" y="1085" as="targetPoint"/></mxGeometry></mxCell><mxCell id="53" value="17. saveImages(): validate and attach image bytes;&lt;br&gt;build info(row)" style="html=1;fontFamily=Arial;fontSize=15;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="804" y="1160" as="sourcePoint"/><mxPoint x="804" y="1188" as="targetPoint"/><Array as="points"><mxPoint x="849" y="1160"/><mxPoint x="849" y="1188"/></Array></mxGeometry></mxCell><mxCell id="54" value="18. RegistrationInfo (PENDING); transaction commits" style="html=1;fontFamily=Arial;fontSize=15;endArrow=open;endFill=0;dashed=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="796" y="1260" as="sourcePoint"/><mxPoint x="544" y="1260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="55" value="19. HTTP 201 Created + ApiResponse" style="html=1;fontFamily=Arial;fontSize=15;endArrow=open;endFill=0;dashed=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="536" y="1320" as="sourcePoint"/><mxPoint x="304" y="1320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="56" value="20. Show Pending review" style="html=1;fontFamily=Arial;fontSize=15;endArrow=open;endFill=0;dashed=1;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="296" y="1380" as="sourcePoint"/><mxPoint x="84" y="1380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="57" value="Scope: successful submission by an authenticated active account. Invalid data → 400; conflicting application/name → 409; failures roll back the transaction.&lt;br&gt;Images: 1–5 JPG/PNG/WEBP, each ≤ 5 MB; persisted through JPA dirty checking at commit. Documents are optional.&lt;br&gt;Submission does not grant MANAGE_SERVICE or publish a Service. Staff/Admin review or configured AI CREATE review runs separately." style="html=1;fontFamily=Arial;fontSize=15;shape=note;size=15;fillColor=#FFFDE7;strokeColor=#BDB76B;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="1460" width="2100" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
