<mxPoint x="795" y="633"/></Array></mxGeometry></mxCell><mxCell id="52" value="4. Require active STAFF / ADMIN.&lt;br&gt;Review: validate decisions and reason;&lt;br&gt;use default approval reason if blank." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="805" y="595" width="490" height="72" as="geometry"/></mxCell><mxCell id="53" value="" style="endArrow=open;endFill=0;strokeColor=#455A64;strokeWidth=1.3;fontSize=20;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="755" as="sourcePoint"/><mxPoint x="1095" y="755" as="targetPoint"/></mxGeometry></mxCell><mxCell id="54" value="5. findForReview(id)&lt;br&gt;Lock application" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="761" y="701" width="328" height="48" as="geometry"/></mxCell><mxCell id="55" value="" style="rounded=0;fillColor=#83CDE5;strokeColor=#455A64;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1095" y="755" width="10" height="22" as="geometry"/></mxCell><mxCell id="56" value="" style="endArrow=open;endFill=0;strokeColor=#455A64;strokeWidth=1.3;fontSize=20;dashed=1;dashPattern=5 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1095" y="805" as="sourcePoint"/><mxPoint x="755" y="805" as="targetPoint"/></mxGeometry></mxCell><mxCell id="57" value="6. Application" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="761" y="775" width="328" height="24" as="geometry"/></mxCell><mxCell id="58" value="" style="endArrow=open;endFill=0;strokeColor=#455A64;strokeWidth=1.3;fontSize=20;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="850" as="sourcePoint"/><mxPoint x="755" y="878" as="targetPoint"/><Array as="points"><mxPoint x="795" y="850"/><mxPoint x="795" y="878"/></Array></mxGeometry></mxCell><mxCell id="59" value="7. Reject self-review; require PENDING&lt;br&gt;and matching application revision." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="805" y="840" width="490" height="48" as="geometry"/></mxCell><mxCell id="60" value="[Approve or Reject]" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=1;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="690" y="995" width="740" height="30" as="geometry"/></mxCell><mxCell id="61" value="" style="endArrow=open;endFill=0;strokeColor=#455A64;strokeWidth=1.3;fontSize=20;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="1100" as="sourcePoint"/><mxPoint x="1095" y="1100" as="targetPoint"/></mxGeometry></mxCell><mxCell id="62" value="8. Lock applicant account;&lt;br&gt;require ACTIVE" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="761" y="1046" width="328" height="48" as="geometry"/></mxCell><mxCell id="63" value="" style="rounded=0;fillColor=#83CDE5;strokeColor=#455A64;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1095" y="1100" width="10" height="22" as="geometry"/></mxCell><mxCell id="64" value="" style="endArrow=open;endFill=0;strokeColor=#455A64;strokeWidth=1.3;fontSize=20;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="1190" as="sourcePoint"/><mxPoint x="1095" y="1190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="65" value="9. Load optional documents" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="761" y="1160" width="328" height="24" as="geometry"/></mxCell><mxCell id="66" value="" style="rounded=0;fillColor=#83CDE5;strokeColor=#455A64;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1095" y="1190" width="10" height="22" as="geometry"/></mxCell><mxCell id="67" value="[APPROVE / APPROVE]" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=1;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="805" y="1280" width="560" height="30" as="geometry"/></mxCell><mxCell id="68" value="" style="endArrow=open;endFill=0;strokeColor=#455A64;strokeWidth=1.3;fontSize=20;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="1390" as="sourcePoint"/><mxPoint x="1095" y="1390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="69" value="10. Validate stored documents;&lt;br&gt;get MANAGE_SERVICE;&lt;br&gt;save ACTIVE grant if needed" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="761" y="1312" width="328" height="72" as="geometry"/></mxCell><mxCell id="70" value="" style="rounded=0;fillColor=#83CDE5;strokeColor=#455A64;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1095" y="1390" width="10" height="22" as="geometry"/></mxCell><mxCell id="71" value="" style="endArrow=open;endFill=0;strokeColor=#455A64;strokeWidth=1.3;fontSize=20;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="1500" as="sourcePoint"/><mxPoint x="1095" y="1500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="72" value="11. Check duplicate name / listing;&lt;br&gt;validate fields; save ACTIVE&lt;br&gt;Service linked to this snapshot" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="761" y="1422" width="328" height="72" as="geometry"/></mxCell><mxCell id="73" value="" style="rounded=0;fillColor=#83CDE5;strokeColor=#455A64;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1095" y="1500" width="10" height="22" as="geometry"/></mxCell><mxCell id="74" value="[REJECT / REJECT]" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=1;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="805" y="1605" width="560" height="30" as="geometry"/></mxCell><mxCell id="75" value="12. Do not create a Service&lt;br&gt;or revoke an existing capability." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="820" y="1650" width="575" height="65" as="geometry"/></mxCell><mxCell id="76" value="" style="endArrow=open;endFill=0;strokeColor=#455A64;strokeWidth=1.3;fontSize=20;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="1770" as="sourcePoint"/><mxPoint x="755" y="1798" as="targetPoint"/><Array as="points"><mxPoint x="795" y="1770"/><mxPoint x="795" y="1798"/></Array></mxGeometry></mxCell><mxCell id="77" value="13. Set APPROVED or REJECTED;&lt;br&gt;store decisions; update document status." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="805" y="1760" width="490" height="48" as="geometry"/></mxCell><mxCell id="78" value="[Request supplement]" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=1;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="690" y="1840" width="740" height="30" as="geometry"/></mxCell><mxCell id="79" value="" style="endArrow=open;endFill=0;strokeColor=#455A64;strokeWidth=1.3;fontSize=20;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="1900" as="sourcePoint"/><mxPoint x="755" y="1928" as="targetPoint"/><Array as="points"><mxPoint x="795" y="1900"/><mxPoint x="795" y="1928"/></Array></mxGeometry></mxCell><mxCell id="80" value="14. Validate reason: 10–2000 characters.&lt;br&gt;Set NEEDS_SUPPLEMENT,&lt;br&gt;requestedChanges and supplement time." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="805" y="1890" width="490" height="72" as="geometry"/></mxCell><mxCell id="81" value="No applicant-account lock in this branch.&lt;br&gt;Capability and public listing remain unchanged." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="800" y="2020" width="620" height="65" as="geometry"/></mxCell><mxCell id="82" value="" style="endArrow=open;endFill=0;strokeColor=#455A64;strokeWidth=1.3;fontSize=20;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="2150" as="sourcePoint"/><mxPoint x="755" y="2178" as="targetPoint"/><Array as="points"><mxPoint x="795" y="2150"/><mxPoint x="795" y="2178"/></Array></mxGeometry></mxCell><mxCell id="83" value="15. Set reviewer, reviewedAt and reason;&lt;br&gt;increment application revision." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="805" y="2140" width="490" height="48" as="geometry"/></mxCell><mxCell id="84" value="" style="endArrow=open;endFill=0;strokeColor=#455A64;strokeWidth=1.3;fontSize=20;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="2250" as="sourcePoint"/><mxPoint x="1095" y="2250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="85" value="16. saveAndFlush(application);&lt;br&gt;saveAndFlush(moderation log)" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="761" y="2196" width="328" height="48" as="geometry"/></mxCell><mxCell id="86" value="" style="rounded=0;fillColor=#83CDE5;strokeColor=#455A64;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1095" y="2250" width="10" height="22" as="geometry"/></mxCell><mxCell id="87" value="" style="endArrow=open;endFill=0;strokeColor=#455A64;strokeWidth=1.3;fontSize=20;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="2345" as="sourcePoint"/><mxPoint x="1355" y="2345" as="targetPoint"/></mxGeometry></mxCell><mxCell id="88" value="17. send(applicant, APPLICATION, result, ...)&lt;br&gt;Save notice and publish update event" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="761" y="2291" width="588" height="48" as="geometry"/></mxCell><mxCell id="89" value="" style="rounded=0;fillColor=#83CDE5;strokeColor=#455A64;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1355" y="2345" width="10" height="22" as="geometry"/></mxCell><mxCell id="90" value="" style="endArrow=open;endFill=0;strokeColor=#455A64;strokeWidth=1.3;fontSize=20;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="2405" as="sourcePoint"/><mxPoint x="755" y="2433" as="targetPoint"/><Array as="points"><mxPoint x="795" y="2405"/><mxPoint x="795" y="2433"/></Array></mxGeometry></mxCell><mxCell id="91" value="18. detail(id): application + audit history&lt;br&gt;and current listing snapshot, if present." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="805" y="2395" width="490" height="48" as="geometry"/></mxCell><mxCell id="92" value="" style="endArrow=open;endFill=0;strokeColor=#455A64;strokeWidth=1.3;fontSize=20;dashed=1;dashPattern=5 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="2490" as="sourcePoint"/><mxPoint x="525" y="2490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="93" value="19. Detail;&lt;br&gt;transaction commits" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="531" y="2436" width="208" height="48" as="geometry"/></mxCell><mxCell id="94" value="" style="endArrow=open;endFill=0;strokeColor=#455A64;strokeWidth=1.3;fontSize=20;dashed=1;dashPattern=5 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="2565" as="sourcePoint"/><mxPoint x="305" y="2565" as="targetPoint"/></mxGeometry></mxCell><mxCell id="95" value="20. HTTP 200&lt;br&gt;ApiResponse&lt;Detail&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="311" y="2511" width="198" height="48" as="geometry"/></mxCell><mxCell id="96" value="" style="endArrow=open;endFill=0;strokeColor=#455A64;strokeWidth=1.3;fontSize=20;dashed=1;dashPattern=5 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="2640" as="sourcePoint"/><mxPoint x="85" y="2640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="97" value="21. Show result&lt;br&gt;and review history" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1"><mxGeometry x="91" y="2586" width="198" height="48" as="geometry"/></mxCell><mxCell id="98" value="" style="rounded=0;fillColor=#83CDE5;strokeColor=#455A64;fontSize=20;" vertex="1" parent="1"><mxGeometry x="75" y="2535" width="10" height="110" as="geometry"/></mxCell><mxCell id="99" value="" style="rounded=0;fillColor=#83CDE5;strokeColor=#455A64;fontSize=20;" vertex="1" parent="1"><mxGeometry x="295" y="2470" width="10" height="175" as="geometry"/></mxCell><mxCell id="100" value="" style="rounded=0;fillColor=#83CDE5;strokeColor=#455A64;fontSize=20;" vertex="1" parent="1"><mxGeometry x="515" y="2400" width="10" height="170" as="geometry"/></mxCell><mxCell id="101" value="" style="rounded=0;fillColor=#83CDE5;strokeColor=#455A64;fontSize=20;" vertex="1" parent="1"><mxGeometry x="745" y="2330" width="10" height="165" as="geometry"/></mxCell><mxCell id="102" value="" style="rounded=0;fillColor=#FFFDEB;strokeColor=#D8D0AA;fontSize=20;" vertex="1" parent="1"><mxGeometry x="24" y="2690" width="1442" height="190" as="geometry"/></mxCell><mxCell id="103" value="Scope and source mapping&lt;br&gt;Persistence is a visual group, not a new class: ServiceRegistrationRepository, UserRepository,&lt;br&gt;ServiceDocumentRepository, CapabilityRepository, UserCapabilityRepository, ServiceRepository,&lt;br&gt;and ModerationLogRepository. NoticeService saves UserNotice internally.&lt;br&gt;Review reason: rejection requires 10–2000 characters; approval may use the default reason.&lt;br&gt;Errors stop the flow and roll back writes: 400 invalid data, 403 forbidden, 404 missing, 409 conflict.&lt;br&gt;No staff assignment is required. Existing account role is unchanged. AI review is outside this diagram." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#172B35;fontStyle=0;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="2700" width="1410" height="172" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
