mxGeometry x="655" y="1223" width="295" height="76" as="geometry"/></mxCell><mxCell id="edge36" style="edgeStyle=none;endArrow=none;endFill=0;dashed=0;strokeColor=#63846B;exitX=1;exitY=0.42;entryX=0.5;entryY=1;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="primary" target="UC-ST09"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="182" y="648"/><mxPoint x="182" y="1307"/><mxPoint x="802.5" y="1307"/></Array></mxGeometry></mxCell><mxCell id="UC-ST10" value="UC-ST10&#xa;Sign in and&#xa;sign out" style="ellipse;whiteSpace=wrap;html=0;fillColor=#EADCF2;strokeColor=#9468A6;fontSize=16;fontFamily=Arial;fontStyle=1;fontColor=#254334;spacing=7;" vertex="1" parent="1"><mxGeometry x="1010" y="1223" width="295" height="76" as="geometry"/></mxCell><mxCell id="edge37" style="edgeStyle=none;endArrow=none;endFill=0;dashed=0;strokeColor=#63846B;exitX=1;exitY=0.42;entryX=0.5;entryY=1;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="primary" target="UC-ST10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="194" y="648"/><mxPoint x="194" y="1311"/><mxPoint x="1157.5" y="1311"/></Array></mxGeometry></mxCell><mxCell id="support-worker" value="" style="shape=umlActor;fillColor=#E1EFD9;strokeColor=#4C795B;" vertex="1" parent="1"><mxGeometry x="1427" y="1069" width="46" height="88" as="geometry"/></mxCell><mxCell id="text38" value="«Supporting Actor»&#xa;Collection worker" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;fontFamily=Arial;fontStyle=1;fontColor=#254334;spacing=0;" vertex="1" parent="1"><mxGeometry x="1350" y="1163" width="200" height="65" as="geometry"/></mxCell><mxCell id="edge39" style="edgeStyle=none;endArrow=none;endFill=0;dashed=0;strokeColor=#63846B;exitX=0;exitY=0.42;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="support-worker" target="UC-ST07.1"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="text40" value="Dashed arrows: optional actions extend inspection at the stated condition. Solid lines: actor participation, not execution order." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontFamily=Arial;fontStyle=0;fontColor=#254334;spacing=0;" vertex="1" parent="1"><mxGeometry x="35" y="1331" width="1530" height="25" as="geometry"/></mxCell><mxCell id="text41" value="Property decisions follow assignment policy and version checks. Staff cannot manage accounts, resolve community reports or change AI settings." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontFamily=Arial;fontStyle=0;fontColor=#254334;spacing=0;" vertex="1" parent="1"><mxGeometry x="35" y="1360" width="1530" height="25" as="geometry"/></mxCell><mxCell id="text42" value="Scope: role-specific operations plus shared account access. Prototype assistance and accommodation-review moderation are excluded. Source: 25 November 2026." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontFamily=Arial;fontStyle=0;fontColor=#254334;spacing=0;" vertex="1" parent="1"><mxGeometry x="35" y="1391" width="1530" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>