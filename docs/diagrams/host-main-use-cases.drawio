<mxfile host="app.diagrams.net" type="device"><diagram id="host-main-use-cases" name="Host Main Use Cases"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1132"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="boundary" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#365563;" vertex="1" parent="1"><mxGeometry x="225" y="108" width="1335" height="924" as="geometry"/></mxCell><mxCell id="t2" value="NestHub Host Management" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="36" y="22" width="1500" height="42" as="geometry"/></mxCell><mxCell id="t3" value="Main use cases • One system boundary • Current implementation" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="38" y="69" width="1490" height="26" as="geometry"/></mxCell><mxCell id="t4" value="NestHub system boundary" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="245" y="113" width="1100" height="30" as="geometry"/></mxCell><mxCell id="t5" value="MAIN GOAL" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="340" y="149" width="400" height="22" as="geometry"/></mxCell><mxCell id="t6" value="GROUPED SCOPE AND EXECUTION CONDITIONS" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="820" y="149" width="700" height="22" as="geometry"/></mxCell><mxCell id="band0" value="" style="rounded=0;fillColor=#FAFBF7;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="245" y="176" width="1295" height="84" as="geometry"/></mxCell><mxCell id="UC-H01" value="UC-H01&#xa;Register and track&#xa;property application" style="ellipse;whiteSpace=wrap;html=0;fillColor=#FFF1D4;strokeColor=#B68B43;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#263943;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="182" width="400" height="72" as="geometry"/></mxCell><mxCell id="t7" value="Submit evidence; track review; provide requested supplements." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="820" y="180" width="710" height="24" as="geometry"/></mxCell><mxCell id="t8" value="USER: combined onboarding. Approval grants ROOM_HOST.&#xa;Existing ROOM_HOST: use the property-registration flow." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="820" y="205" width="710" height="48" as="geometry"/></mxCell><mxCell id="band1" value="" style="rounded=0;fillColor=#F3F7F7;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="245" y="264" width="1295" height="84" as="geometry"/></mxCell><mxCell id="UC-H02" value="UC-H02&#xa;Maintain property information&#xa;and verification" style="ellipse;whiteSpace=wrap;html=0;fillColor=#FFF1D4;strokeColor=#B68B43;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#263943;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="270" width="400" height="72" as="geometry"/></mxCell><mxCell id="t9" value="View details; submit changes and replacement evidence." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="820" y="268" width="710" height="24" as="geometry"/></mxCell><mxCell id="t10" value="After registration. Important changes require re-verification;&#xa;public access stays blocked until the required approval." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="820" y="293" width="710" height="48" as="geometry"/></mxCell><mxCell id="band2" value="" style="rounded=0;fillColor=#FAFBF7;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="245" y="352" width="1295" height="84" as="geometry"/></mxCell><mxCell id="UC-H03" value="UC-H03&#xa;Configure room types&#xa;and individual rooms" style="ellipse;whiteSpace=wrap;html=0;fillColor=#FFF1D4;strokeColor=#B68B43;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#263943;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="358" width="400" height="72" as="geometry"/></mxCell><mxCell id="t11" value="Create, edit or remove types/rooms; set layout, prices and amenities." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="820" y="356" width="710" height="24" as="geometry"/></mxCell><mxCell id="t12" value="For an owned, approved and active property.&#xa;Deletion remains subject to linked data and occupancy checks." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="820" y="381" width="710" height="48" as="geometry"/></mxCell><mxCell id="band3" value="" style="rounded=0;fillColor=#F3F7F7;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="245" y="440" width="1295" height="84" as="geometry"/></mxCell><mxCell id="UC-H04" value="UC-H04&#xa;Publish rooms and&#xa;confirm availability" style="ellipse;whiteSpace=wrap;html=0;fillColor=#FFF1D4;strokeColor=#B68B43;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#263943;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="446" width="400" height="72" as="geometry"/></mxCell><mxCell id="t13" value="Select public rooms; confirm room-type availability freshness." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="820" y="444" width="710" height="24" as="geometry"/></mxCell><mxCell id="t14" value="After room setup. Publication also requires public eligibility.&#xa;A confirmation does not itself change room occupancy." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="820" y="469" width="710" height="48" as="geometry"/></mxCell><mxCell id="band4" value="" style="rounded=0;fillColor=#FAFBF7;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="245" y="528" width="1295" height="84" as="geometry"/></mxCell><mxCell id="UC-H05" value="UC-H05&#xa;Handle room viewing&#xa;requests" style="ellipse;whiteSpace=wrap;html=0;fillColor=#FFF1D4;strokeColor=#B68B43;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#263943;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="534" width="400" height="72" as="geometry"/></mxCell><mxCell id="t15" value="View requests; approve individually or in a batch; reject with reason." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="820" y="532" width="710" height="24" as="geometry"/></mxCell><mxCell id="t16" value="For requests to the host's property. No physical room is reserved.&#xa;An approved viewing is NOT required before starting a tenancy." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="820" y="557" width="710" height="48" as="geometry"/></mxCell><mxCell id="band5" value="" style="rounded=0;fillColor=#F3F7F7;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="245" y="616" width="1295" height="84" as="geometry"/></mxCell><mxCell id="UC-H06" value="UC-H06&#xa;Manage tenancies&#xa;and occupants" style="ellipse;whiteSpace=wrap;html=0;fillColor=#FFF1D4;strokeColor=#B68B43;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#263943;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="622" width="400" height="72" as="geometry"/></mxCell><mxCell id="t17" value="Start/end a stay; manage occupants, occupancy and lease dates." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="820" y="620" width="710" height="24" as="geometry"/></mxCell><mxCell id="t18" value="Requires an owned room and valid tenancy data.&#xa;Keep previous stays and occupant history when closing a tenancy." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="820" y="645" width="710" height="48" as="geometry"/></mxCell><mxCell id="band6" value="" style="rounded=0;fillColor=#FAFBF7;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="245" y="704" width="1295" height="84" as="geometry"/></mxCell><mxCell id="UC-H07" value="UC-H07&#xa;Manage rental contracts&#xa;and signing" style="ellipse;whiteSpace=wrap;html=0;fillColor=#FFF1D4;strokeColor=#B68B43;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#263943;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="710" width="400" height="72" as="geometry"/></mxCell><mxCell id="t19" value="Prepare/review a contract; optionally scan; sign and share a tenant link." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="820" y="708" width="710" height="24" as="geometry"/></mxCell><mxCell id="t20" value="Optional for an occupied room with lease dates; retain contract history.&#xa;Tenant signs separately using an eligible account and valid link." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="820" y="733" width="710" height="48" as="geometry"/></mxCell><mxCell id="band7" value="" style="rounded=0;fillColor=#F3F7F7;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="245" y="792" width="1295" height="84" as="geometry"/></mxCell><mxCell id="UC-H08" value="UC-H08&#xa;Manage utilities, bills&#xa;and payment records" style="ellipse;whiteSpace=wrap;html=0;fillColor=#FFF1D4;strokeColor=#B68B43;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#263943;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="798" width="400" height="72" as="geometry"/></mxCell><mxCell id="t21" value="Record utilities; set collection cycles; draft/issue bills; record payments." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="820" y="796" width="710" height="24" as="geometry"/></mxCell><mxCell id="t22" value="Uses the relevant tenancy. Final readings are required when billed.&#xa;Rent can be billed before utilities; payments are recorded, not processed." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="820" y="821" width="710" height="48" as="geometry"/></mxCell><mxCell id="applicant" value="" style="shape=umlActor;fillColor=#FFFFFF;strokeColor=#365563;" vertex="1" parent="1"><mxGeometry x="80" y="151" width="44" height="92" as="geometry"/></mxCell><mxCell id="t23" value="APPLICANT&#xa;USER" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="2" y="248" width="200" height="48" as="geometry"/></mxCell><mxCell id="host" value="" style="shape=umlActor;fillColor=#FFFFFF;strokeColor=#365563;" vertex="1" parent="1"><mxGeometry x="80" y="531" width="44" height="92" as="geometry"/></mxCell><mxCell id="t24" value="ROOM HOST&#xa;ROOM_HOST" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="2" y="628" width="200" height="48" as="geometry"/></mxCell><mxCell id="edge25" style="edgeStyle=none;rounded=0;endArrow=none;startArrow=none;strokeColor=#7B8D94;strokeWidth=1;exitX=1;exitY=0.4;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="applicant" target="UC-H01"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="205" y="188"/><mxPoint x="205" y="212"/></Array></mxGeometry></mxCell><mxCell id="edge26" style="edgeStyle=none;rounded=0;endArrow=none;startArrow=none;strokeColor=#7B8D94;strokeWidth=1;exitX=1;exitY=0.4;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="host" target="UC-H01"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge27" style="edgeStyle=none;rounded=0;endArrow=none;startArrow=none;strokeColor=#7B8D94;strokeWidth=1;exitX=1;exitY=0.4;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="host" target="UC-H02"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge28" style="edgeStyle=none;rounded=0;endArrow=none;startArrow=none;strokeColor=#7B8D94;strokeWidth=1;exitX=1;exitY=0.4;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="host" target="UC-H03"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge29" style="edgeStyle=none;rounded=0;endArrow=none;startArrow=none;strokeColor=#7B8D94;strokeWidth=1;exitX=1;exitY=0.4;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="host" target="UC-H04"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge30" style="edgeStyle=none;rounded=0;endArrow=none;startArrow=none;strokeColor=#7B8D94;strokeWidth=1;exitX=1;exitY=0.4;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="host" target="UC-H05"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge31" style="edgeStyle=none;rounded=0;endArrow=none;startArrow=none;strokeColor=#7B8D94;strokeWidth=1;exitX=1;exitY=0.4;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="host" target="UC-H06"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge32" style="edgeStyle=none;rounded=0;endArrow=none;startArrow=none;strokeColor=#7B8D94;strokeWidth=1;exitX=1;exitY=0.4;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="host" target="UC-H07"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge33" style="edgeStyle=none;rounded=0;endArrow=none;startArrow=none;strokeColor=#7B8D94;strokeWidth=1;exitX=1;exitY=0.4;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="host" target="UC-H08"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t34" value="AVAILABLE THROUGHOUT HOST OPERATIONS" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="260" y="889" width="1200" height="24" as="geometry"/></mxCell><mxCell id="UC-H09" value="UC-H09  Account and profile&#xa;Sign in/out; profile; password" style="ellipse;whiteSpace=wrap;html=0;fillColor=#E7F3EE;strokeColor=#5B8C78;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#263943;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="925" width="340" height="66" as="geometry"/></mxCell><mxCell id="UC-H10" value="UC-H10  Host dashboard&#xa;Owned property and room overview" style="ellipse;whiteSpace=wrap;html=0;fillColor=#E7F3EE;strokeColor=#5B8C78;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#263943;spacing=8;" vertex="1" parent="1"><mxGeometry x="770" y="925" width="340" height="66" as="geometry"/></mxCell><mxCell id="UC-H11" value="UC-H11  Notifications&#xa;View and mark as read" style="ellipse;whiteSpace=wrap;html=0;fillColor=#E7F3EE;strokeColor=#5B8C78;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#263943;spacing=8;" vertex="1" parent="1"><mxGeometry x="1200" y="925" width="340" height="66" as="geometry"/></mxCell><mxCell id="edge35" style="edgeStyle=none;rounded=0;endArrow=none;startArrow=none;strokeColor=#7B8D94;strokeWidth=1;exitX=1;exitY=0.4;entryX=0.5;entryY=1;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="host" target="UC-H09"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="185" y="568"/><mxPoint x="185" y="1020"/><mxPoint x="510" y="1020"/></Array></mxGeometry></mxCell><mxCell id="edge36" style="edgeStyle=none;rounded=0;endArrow=none;startArrow=none;strokeColor=#7B8D94;strokeWidth=1;exitX=1;exitY=0.4;entryX=0.5;entryY=1;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="host" target="UC-H10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="195" y="568"/><mxPoint x="195" y="1024"/><mxPoint x="940" y="1024"/></Array></mxGeometry></mxCell><mxCell id="edge37" style="edgeStyle=none;rounded=0;endArrow=none;startArrow=none;strokeColor=#7B8D94;strokeWidth=1;exitX=1;exitY=0.4;entryX=0.5;entryY=1;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="host" target="UC-H11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="205" y="568"/><mxPoint x="205" y="1028"/><mxPoint x="1370" y="1028"/></Array></mxGeometry></mxCell><mxCell id="t38" value="Read 01–08 from top to bottom as a business guide; the conditions define the actual prerequisites.&#xa;Solid lines show actor participation, not a mandatory sequence. No include/extend arrows are used to imply execution order." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="38" y="1048" width="1510" height="42" as="geometry"/></mxCell><mxCell id="t39" value="Scope: implemented host operations. Shared member/community features and optional Service Provider capability form separate modules.&#xa;Support-request screens are prototypes and are excluded. Source snapshot: 25 November 2026." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontStyle=0;fontColor=#263943;" vertex="1" parent="1"><mxGeometry x="38" y="1094" width="1510" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>