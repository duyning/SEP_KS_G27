dOnly}" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;spacing=0;" vertex="1" parent="18"><mxGeometry x="12" y="68" width="526" height="130" as="geometry"/></mxCell><mxCell id="27" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#547782;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="550" height="118" as="geometry"/></mxCell><mxCell id="28" value="«Record»&#xa;StaffService.FileContent" style="rounded=0;fillColor=#B1DFE7;strokeColor=#547782;whiteSpace=wrap;html=0;align=left;spacingLeft=12;fontSize=15;fontStyle=1;" vertex="1" parent="27"><mxGeometry width="550" height="60" as="geometry"/></mxCell><mxCell id="29" value="- bytes: byte[] {readOnly}&#xa;- contentType: String {readOnly}" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;spacing=0;" vertex="1" parent="27"><mxGeometry x="12" y="68" width="526" height="50" as="geometry"/></mxCell><mxCell id="30" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#547782;" vertex="1" parent="1"><mxGeometry x="675" y="1000" width="1185" height="236" as="geometry"/></mxCell><mxCell id="31" value="«Generic response envelope»&#xa;ApiResponse&lt;T&gt;" style="rounded=0;fillColor=#B1DFE7;strokeColor=#547782;whiteSpace=wrap;html=0;align=left;spacingLeft=12;fontSize=15;fontStyle=1;" vertex="1" parent="30"><mxGeometry width="1185" height="60" as="geometry"/></mxCell><mxCell id="32" value="- success: boolean&#xa;- message: String&#xa;- data: T&#xa;- timestamp: LocalDateTime" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;spacing=0;" vertex="1" parent="30"><mxGeometry x="12" y="68" width="1161" height="90" as="geometry"/></mxCell><mxCell id="33" value="" style="line;strokeColor=#547782;" vertex="1" parent="30"><mxGeometry y="158" width="1185" height="1" as="geometry"/></mxCell><mxCell id="34" value="+ success&lt;T&gt;(data: T): ApiResponse&lt;T&gt; {static}&#xa;+ success&lt;T&gt;(message: String, data: T): ApiResponse&lt;T&gt; {static}&#xa;+ error&lt;T&gt;(message: String): ApiResponse&lt;T&gt; {static}" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;spacing=0;" vertex="1" parent="30"><mxGeometry x="12" y="166" width="1161" height="70" as="geometry"/></mxCell><mxCell id="35" value="Records are immutable Java records; component accessors, canonical constructors, equals/hashCode/toString are generated and omitted.&#xa;Input: serviceId ≥ 1; content 10–3000 characters. Explanation/Decision: revision ≥ 0; content 10–3000 characters.&#xa;Decision.action is a String restricted to REQUEST_EXPLANATION | DISMISS | REMOVE, not a Java enum.&#xa;DTO associations represent references, not JPA relationships; string image URLs are not entity associations." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1300" width="1820" height="150" as="geometry"/></mxCell><mxCell id="21" style="edgeStyle=none;rounded=0;html=0;exitX=0;exitY=0.6;entryX=1;entryY=0.5;endArrow=open;endFill=0;strokeColor=#475569;" edge="1" parent="1" source="15" target="12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="22" value="" style="edgeLabel;html=0;align=left;verticalAlign=middle;fontSize=14;" vertex="1" connectable="0" parent="21"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="-50" y="-18" as="offset"/></mxGeometry></mxCell><mxCell id="23" value="1" style="edgeLabel;html=0;align=left;verticalAlign=middle;fontSize=14;" vertex="1" connectable="0" parent="21"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="10" y="-18" as="offset"/></mxGeometry></mxCell><mxCell id="24" style="edgeStyle=none;rounded=0;html=0;exitX=1;exitY=0.6;entryX=0;entryY=0.5;endArrow=open;endFill=0;strokeColor=#475569;" edge="1" parent="1" source="15" target="18"><mxGeome