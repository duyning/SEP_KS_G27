;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;spacing=0;" vertex="1" parent="11"><mxGeometry x="12" y="68" width="526" height="90" as="geometry"/></mxCell><mxCell id="14" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#547782;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="550" height="198" as="geometry"/></mxCell><mxCell id="15" value="«Entity» relevant members only&#xa;Service" style="rounded=0;fillColor=#B1DFE7;strokeColor=#547782;whiteSpace=wrap;html=0;align=left;spacingLeft=12;fontSize=15;fontStyle=1;" vertex="1" parent="14"><mxGeometry width="550" height="60" as="geometry"/></mxCell><mxCell id="16" value="- serviceId: Integer&#xa;- provider: User&#xa;- serviceName: String&#xa;- status: String&#xa;- moderationHidden: boolean&#xa;- revision: int" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;spacing=0;" vertex="1" parent="14"><mxGeometry x="12" y="68" width="526" height="130" as="geometry"/></mxCell><mxCell id="17" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#547782;" vertex="1" parent="1"><mxGeometry x="675" y="880" width="550" height="118" as="geometry"/></mxCell><mxCell id="18" value="«Embeddable» all fields&#xa;ServiceImage" style="rounded=0;fillColor=#B1DFE7;strokeColor=#547782;whiteSpace=wrap;html=0;align=left;spacingLeft=12;fontSize=15;fontStyle=1;" vertex="1" parent="17"><mxGeometry width="550" height="60" as="geometry"/></mxCell><mxCell id="19" value="- content: byte[]&#xa;- contentType: String" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;spacing=0;" vertex="1" parent="17"><mxGeometry x="12" y="68" width="526" height="50" as="geometry"/></mxCell><mxCell id="20" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#547782;" vertex="1" parent="1"><mxGeometry x="1310" y="880" width="550" height="218" as="geometry"/></mxCell><mxCell id="21" value="«Entity» all fields&#xa;ModerationLog" style="rounded=0;fillColor=#B1DFE7;strokeColor=#547782;whiteSpace=wrap;html=0;align=left;spacingLeft=12;fontSize=15;fontStyle=1;" vertex="1" parent="20"><mxGeometry width="550" height="60" as="geometry"/></mxCell><mxCell id="22" value="- logId: Integer&#xa;- staff: User&#xa;- targetType: String&#xa;- targetId: Integer&#xa;- action: String&#xa;- note: String&#xa;- createdAt: LocalDateTime" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;spacing=0;" vertex="1" parent="20"><mxGeometry x="12" y="68" width="526" height="150" as="geometry"/></mxCell><mxCell id="26" value="complaint" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="594" y="205" width="500" height="30" as="geometry"/></mxCell><mxCell id="30" value="actor" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1230" y="210" width="500" height="30" as="geometry"/></mxCell><mxCell id="34" value="service" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="245" y="740" width="500" height="30" as="geometry"/></mxCell><mxCell id="38" value="reporter" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="760" y="86" width="500" height="30" as="geometry"/></mxCell><mxCell id="42" value="provider" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1460" y="707" width="500" height="30" as="geometry"/></mxCell><mxCell id="46" value="staff" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1600" y="590" width="500" height="30" as="geometry"/></mxCell><mxCell id="50" value="images" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1020" y="675" width="500" height="30" as="geometry"/></mxCell><mxCell id="54" value="images" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="690" y="792" width="500" height="30" as="geometry"/></mxCell><mxCell id="55" value="Solid open arrows: navigable associations. Multiplicities belong to the two association ends. Filled diamond: owned embeddable image values.&#xa;Generated Lombok accessors/constructors are omitted. Service/User are explicitly partial; other entity fields above are complete.&#xa;ServiceComplaint.status and outcome are String fields. Current status: PENDING / RESOLVED; outcome: null / DISMISS / REMOVE.&#xa;Legacy status values remain readable. Event.action: REQUEST_EXPLANATION / EXPLAINED / DISMISS / REMOVE.&#xa;ModerationLog.targetId is a scalar polymorphic ID, not a JPA association to ServiceComplaint. No cascade-delete guarantee is implied for events.&#xa;Each image value has one owner: complaint XOR event; request validation limits each image list to five.&#xa;UserRole = USER / ROOM_HOST / STAFF / ADMIN; UserStatus = ACTIVE / INACTIVE. MANAGE_SERVICE is a capability, not a role." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1240" width="1820" height="150" as="geometry"/></mxCell><mxCell id="23" style="edgeStyle=none;rounded=0;html=0;exitX=0;exitY=0.4;entryX=1;entryY=0.3;endArrow=open;endFill=0;strokeColor=#475569;" edge="1" parent="1" source="8" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="24" value="0..*" style="edgeLabel