;+ detail(id: Integer): Detail&#xa;+ submit(serviceId: Integer, content: String, images: List&lt;MultipartFile&gt;): Detail {throws IOException}&#xa;- fresh(c: ServiceComplaint, revision: int): void&#xa;- event(c: ServiceComplaint, action: String, content: String, images: List&lt;ServiceImage&gt;): void&#xa;+ explain(id: Integer, revision: int, content: String, images: List&lt;MultipartFile&gt;): Detail {throws IOException}&#xa;+ review(id: Integer, revision: int, action: String, content: String): Detail&#xa;+ image(id: Integer, eventId: Integer, index: int): StaffService.FileContent" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;spacing=0;" vertex="1" parent="8"><mxGeometry x="12" y="266" width="826" height="330" as="geometry"/></mxCell><mxCell id="16" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#547782;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="820" height="162" as="geometry"/></mxCell><mxCell id="17" value="«Utility» final class&#xa;ServiceFeedbackImages" style="rounded=0;fillColor=#B1DFE7;strokeColor=#547782;whiteSpace=wrap;html=0;align=left;spacingLeft=12;fontSize=15;fontStyle=1;" vertex="1" parent="16"><mxGeometry width="820" height="60" as="geometry"/></mxCell><mxCell id="18" value="" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;spacing=0;" vertex="1" parent="16"><mxGeometry x="12" y="68" width="796" height="16" as="geometry"/></mxCell><mxCell id="19" value="" style="line;strokeColor=#547782;" vertex="1" parent="16"><mxGeometry y="84" width="820" height="1" as="geometry"/></mxCell><mxCell id="20" value="- ServiceFeedbackImages()&#xa;+ read(files: List&lt;MultipartFile&gt;): List&lt;ServiceImage&gt; {static; throws IOException}&#xa;+ text(value: String, min: int): String {static}" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;spacing=0;" vertex="1" parent="16"><mxGeometry x="12" y="92" width="796" height="70" as="geometry"/></mxCell><mxCell id="22" value="validates content and images" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="650" y="800" width="500" height="30" as="geometry"/></mxCell><mxCell id="23" value="Scope: all declared fields and operations of the complaint controller/service; constructors and Lombok-generated members omitted.&#xa;Input, Explanation and Decision are nested controller records; Summary, Event and Detail are nested service records (DTO page).&#xa;AuthService, ServicePublicationService, EntityManager and the three shared repositories are external collaborators named in the attributes.&#xa;No inheritance or ownership is implied by an injected reference. FileContent is StaffService.FileContent (DTO page)." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="1820" height="150" as="geometry"/></mxCell><mxCell id="13" style="edgeStyle=none;rounded=0;html=0;exitX=1;exitY=0.13;entryX=0;entryY=0.07;endArrow=open;endFill=0;strokeColor=#475569;" edge="1" parent="1" source="3" target="8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="14" value="" style="edgeLabel;html=0;align=left;verticalAlign=middle;fontSize=14;" vertex="1" connectable="0" parent="13"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="10" y="-18" as="offset"/></mxGeometry></mxCell><mxCell id="15" value="1  service" style="edgeLabel;html=0;align=left;verticalAlign=middle;fontSize=14;" vertex="1" connectable="0" parent="13"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-85" y="-18" as="offset"/></mxGeometry></mxCell><mxCell id="21" style="edgeStyle=none;rounded=0;html=0;exitX=0;exitY=0.76;entryX=1;entryY=0.35;endArrow=open;endFill=0;strokeColor=#475569;dashed=1;" edge="