<mxfile host="app.diagrams.net" type="device"><diagram id="04-classes-application" name="Class Diagram — Controller &amp; Service"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1900" pageHeight="1240"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Class Diagram — Controller &amp; Service" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=28;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1820" height="46" as="geometry"/></mxCell><mxCell id="3" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#547782;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="820" height="296" as="geometry"/></mxCell><mxCell id="4" value="«RestController»&#xa;ServiceComplaintController" style="rounded=0;fillColor=#B1DFE7;strokeColor=#547782;whiteSpace=wrap;html=0;align=left;spacingLeft=12;fontSize=15;fontStyle=1;" vertex="1" parent="3"><mxGeometry width="820" height="60" as="geometry"/></mxCell><mxCell id="5" value="- service: ServiceComplaintService {readOnly}" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;spacing=0;" vertex="1" parent="3"><mxGeometry x="12" y="68" width="796" height="30" as="geometry"/></mxCell><mxCell id="6" value="" style="line;strokeColor=#547782;" vertex="1" parent="3"><mxGeometry y="98" width="820" height="1" as="geometry"/></mxCell><mxCell id="7" value="+ mine(): ApiResponse&lt;?&gt;&#xa;+ incoming(): ApiResponse&lt;?&gt;&#xa;+ list(): ApiResponse&lt;?&gt;&#xa;+ detail(id: Integer): ApiResponse&lt;?&gt;&#xa;+ submit(input: Input, images: List&lt;MultipartFile&gt;): ResponseEntity&lt;?&gt; {throws IOException}&#xa;+ explain(id: Integer, input: Explanation, images: List&lt;MultipartFile&gt;): ApiResponse&lt;?&gt; {throws IOException}&#xa;+ review(id: Integer, input: Decision): ApiResponse&lt;?&gt;&#xa;+ image(id: Integer, index: int): ResponseEntity&lt;byte[]&gt;&#xa;+ eventImage(id: Integer, e